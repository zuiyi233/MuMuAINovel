# ==========================================
# MuMuAINovel 配置文件示例
# ==========================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ==========================================
# 应用配置
# ==========================================
APP_NAME=MuMuAINovel
APP_VERSION=1.3.5
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# ==========================================
# PostgreSQL 数据库配置
# ==========================================

# PostgreSQL 连接信息
POSTGRES_DB=mumuai_novel
POSTGRES_USER=mumuai
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# 数据库连接 URL（Docker 部署时自动生成）
# DATABASE_URL=postgresql+asyncpg://mumuai:123456@localhost:5432/mumuai_novel

# ==========================================
# SQLite 数据库配置
# ==========================================

# DATABASE_URL=sqlite+aiosqlite:///data/ai_story.db

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ==========================================
# CORS 配置
# ==========================================
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ==========================================
# 代理配置（可选）
# ==========================================
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# AI 服务配置（至少配置一个）
# ==========================================

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 默认 AI 配置
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000

# ==========================================
# Vector Embedding 配置（长期记忆）
# ==========================================
# local: 本地 sentence-transformers（默认，缺模型时会自动下载）
# remote_openai: 使用 OpenAI 兼容 /embeddings 接口（不拉本地模型）
# disabled: 关闭向量 embedding（后端可正常启动，向量功能跳过）
VECTOR_EMBEDDING_MODE=local

# 本地模式默认模型：sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 远端模式建议模型：text-embedding-3-small
# VECTOR_EMBEDDING_MODEL=text-embedding-3-small

# 远端模式下可单独配置；不填则回退到 OPENAI_API_KEY / OPENAI_BASE_URL
# VECTOR_EMBEDDING_API_KEY=your_embedding_api_key_here
# VECTOR_EMBEDDING_BASE_URL=https://api.openai.com/v1

# 本地模式下是否禁止自动下载（true 时本地无模型会直接报错）
VECTOR_EMBEDDING_SKIP_LOCAL_DOWNLOAD=false

# ==========================================
# LinuxDO OAuth 配置（可选）
# ==========================================
LINUXDO_CLIENT_ID=11111
LINUXDO_CLIENT_SECRET=11111
LINUXDO_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:8000

# 初始管理员（LinuxDO user_id）
# INITIAL_ADMIN_LINUXDO_ID=your_linuxdo_user_id

# ==========================================
# 本地账户登录配置
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin123
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# ==========================================
# 会话配置
# ==========================================
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30

# ==========================================
# API 缓存配置
# ==========================================
# --- Anthropic 原生协议缓存（api_provider=anthropic）---
# 启用后对 system prompt 发送 cache_control + anthropic-beta header
# 支持官方 Anthropic API 及兼容其缓存协议的第三方中转站（默认启用）
# 若中转站不支持该特性导致报错，可设置为 false 关闭
ENABLE_PROMPT_CACHE=true

# 触发缓存的 system prompt 最小字符数（短于此值不发送 cache_control）
PROMPT_CACHE_MIN_LENGTH=1024

# --- OpenAI 兼容协议缓存（api_provider=openai + 中转站）---
# 适用于 NEW-API / OpenRouter 等支持透传 Anthropic cache_control 的中转站
# 启用后将 system 消息改为带 cache_control 的数组格式
# ⚠️ 仅在中转站后端对接 Anthropic 模型时有效；纯 OpenAI 模型无需开启
# NEW-API 使用说明：
#   方案1（推荐）：在用户设置中将 api_provider 改为 anthropic，直连 NEW-API 的 Anthropic 兼容端口
#   方案2：保持 api_provider=openai，将此项设置为 true（需确认 NEW-API 版本支持透传）
ENABLE_OPENAI_PROMPT_CACHE=false

# ==========================================
# 提示词工坊配置
# ==========================================
# 运行模式：client（本地部署）或 server（云端服务器）
# 只有 mumuverse.space:1566 需要设置为 server
WORKSHOP_MODE=client

# 云端服务地址（client 模式使用）
WORKSHOP_CLOUD_URL=https://mumuverse.space:1566

# 云端 API 请求超时时间（秒）
WORKSHOP_API_TIMEOUT=30
